# Application
APP_URL=http://localhost:3000
# NODE_ENV is set automatically by Next.js (dev/build/start). Do not set it on your host.
JWT_SECRET=replace_with_a_long_random_secret

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/yutira2026

# Admin account — replace both values before deployment
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Email (set EMAIL_ENABLED=false to develop without sending email)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=
SMTP_FROM_NAME=YUTIRA 2026

# Optional: only if you implement/use Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
